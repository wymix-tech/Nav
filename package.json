{
  "name": "nav",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "dev:frontend": "cd packages/frontend && pnpm dev",
    "dev:server": "cd packages/server && pnpm dev",
    "build": "turbo build",
    "lint": "eslint packages tests *.ts *.mjs",
    "prod:build": "bash scripts/prod.sh build",
    "prod:start": "bash scripts/prod.sh start",
    "prod:stop": "bash scripts/prod.sh stop",
    "prod:restart": "bash scripts/prod.sh restart",
    "prod:status": "bash scripts/prod.sh status",
    "test": "pnpm --filter @nav/shared build && node --import tsx --test tests/*.test.ts",
    "typecheck": "pnpm --filter @nav/shared build && pnpm --filter @nav/frontend lint && pnpm --filter @nav/server lint",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "format:check": "prettier --check packages tests *.ts *.mjs *.json",
    "test:browser": "playwright test",
    "db:preflight": "node packages/server/dist/maintenance.js preflight",
    "canvas-v2-preflight": "node packages/server/dist/maintenance.js canvas-v2-preflight",
    "canvas-v2-dry-run": "node packages/server/dist/maintenance.js canvas-v2-dry-run",
    "canvas-v2-migrate": "node packages/server/dist/maintenance.js canvas-v2-migrate",
    "db:backup": "node packages/server/dist/maintenance.js backup",
    "test:performance": "playwright test -c playwright.performance.config.ts",
    "benchmark:spatial": "node --import tsx scripts/benchmark-spatial.ts"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "tsx": "^4.19.0",
    "fake-indexeddb": "^6.0.0",
    "@playwright/test": "^1.51.0",
    "prettier": "^3.4.0",
    "eslint": "^9.0.0",
    "@eslint/js": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "eslint-plugin-vue": "^10.0.0",
    "globals": "^16.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
